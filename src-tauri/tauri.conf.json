{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Widgitron",
  "version": "0.2.6",
  "identifier": "com.evan.widgitron",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Widgitron",
        "width": 1000,
        "height": 740,
        "minWidth": 900,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": true,
        "center": true
      },
      {
        "label": "tray-menu",
        "title": "Tray Menu",
        "width": 150,
        "height": 104,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": [
      "configs/**/*"
    ]
  }
}
